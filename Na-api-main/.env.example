# ============================================================
# DEKUTCONNECT Na-api Dashboard — Environment Variables
# Copy this to .env.local and fill in your values
# ============================================================

# ── Site URL ──
NEXT_PUBLIC_SITE_URL=https://your-dashboard.vercel.app

# ── Session Server URL (gifted-session-main on Vercel) ──
NEXT_PUBLIC_SESSION_SERVER_URL=https://session.bot.connect.dekut.org

# ── Supabase (PostgreSQL Database) ──
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Direct PostgreSQL connection string (for server-side pg Pool)
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Firebase (Client-side Auth + Realtime Database) ──
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDBpcfygHw2pCBrVtMp6dGeIRw2sCAC6TI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dekut-app-main.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dekut-app-main
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dekut-app-main.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=227712751066
NEXT_PUBLIC_FIREBASE_APP_ID=1:227712751066:web:1179019f15578e1de71ce3
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-1K8D7E0YZZ
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://dekut-app-main-default-rtdb.firebaseio.com