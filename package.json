  "type": "commonjs",
  "scripts": {
    "dev": "node index.js",
    "start": "pm2 start index.js --deep-monitoring --attach --name dekutconnect-wa-bot",
    "stop": "pm2 stop dekutconnect-wa-bot",
    "restart": "pm2 restart dekutconnect-wa-bot && pm2 logs",
    "stash": "git stash && git stash drop"
  },
