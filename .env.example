# ============================================================
# DEKUTCONNECT Session Server — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── Server ──
PORT=50900

# ── Database (Supabase PostgreSQL) ──
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Session Config ──
SESSION_PREFIX=DEKUTCONNECT~

# ── Bot Control Mode ──
# 'firebase' = Remote VPS via Firebase RTDB (recommended for VPS deployment)
# 'local'    = Spawn child processes on same machine
BOT_CONTROL_MODE=firebase

# ── Firebase (for Auth + Realtime command bridge) ──
FIREBASE_API_KEY=AIzaSyDBpcfygHw2pCBrVtMp6dGeIRw2sCAC6TI
FIREBASE_AUTH_DOMAIN=dekut-app-main.firebaseapp.com
FIREBASE_PROJECT_ID=dekut-app-main
FIREBASE_STORAGE_BUCKET=dekut-app-main.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=227712751066
FIREBASE_APP_ID=1:227712751066:web:1179019f15578e1de71ce3
FIREBASE_MEASUREMENT_ID=G-1K8D7E0YZZ

# Firebase Admin SDK (base64-encoded service account JSON)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then base64-encode it: cat serviceAccount.json | base64 -w0
FIREBASE_ADMIN_CREDENTIAL=
FIREBASE_SERVICE_ACCOUNT=

# ── WhatsApp Channel & Group ──
GC_JID=GuS93JhyfyE56LOV3ZJTFZ
WA_CHANNEL=https://whatsapp.com/channel/0029VbCpYtZLtOj5LDuj7Q1p
BOT_REPO=https://github.com/dekutconnect/wa-bot

# ── Session Server URL (auto-detected on Vercel via VERCEL_URL) ──
# SESSION_SERVER_URL=https://session.bot.connect.dekut.org
