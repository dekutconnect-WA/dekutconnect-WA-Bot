# ============================================================
# DEKUTCONNECT WhatsApp Bot — VPS Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── Session ──
# Get this from the session server after pairing via QR/code
SESSION_ID=DEKUTCONNECT~your_session_id_here

# ── Session Server ──
# URL of your session server deployment on Vercel
SESSION_SERVER_URL=https://dekutconnect-wa-bot.vercel.app

# ── Bot Identity ──
MODE=public
# MODE=private  (only owner can use commands)

# ── Database (Supabase PostgreSQL) ──
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Na-api Dashboard URL ──
NA_API_URL=https://dekutconnectdownloaders.vercel.app

# ── Firebase Command Bridge ──
# Enables the Vercel dashboard to send commands to this VPS bot
BOT_BRIDGE_ENABLED=true
BOT_UID=your_firebase_user_uid

# Firebase project configuration
FIREBASE_PROJECT_ID=dekut-app-main
FIREBASE_DATABASE_URL=https://dekut-app-main-default-rtdb.firebaseio.com

# Firebase Admin SDK (base64-encoded service account JSON)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then: cat serviceAccount.json | base64 -w0
FIREBASE_ADMIN_CREDENTIAL=

# ── Optional Settings ──
TIME_ZONE=Africa/Nairobi
AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true
PORT=5000
